<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Release;Debug</Configurations>
    <DefineConstants>NETCORE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.1" />
    <!-- Image decode/encode/resize. The Linux native asset is referenced HERE so every consumer
         (App Service Linux, ubuntu CI, workers) loads libSkiaSharp without knowing about it.
         Keep SkiaSharp and SkiaSharp.NativeAssets.Linux.NoDependencies at the SAME version, or
         libSkiaSharp fails to load with a version-mismatch exception. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <!-- EXIF readers (DateTimeOriginal, GPS): a decoded SKBitmap carries no metadata. -->
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.1" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="6.36.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="EastFive.Core.Generators\EastFive.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Net\Client\" />
    <None Remove="Performance\" />
    <None Remove="Serialization\Text\" />
    <None Remove="Serialization\Parquet\" />
    <None Remove="Serialization\DataReader\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="EastFive.Core.Generators\**" />
    <EmbeddedResource Remove="EastFive.Core.Generators\**" />
    <None Remove="EastFive.Core.Generators\**" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Net\Client\" />
    <Folder Include="Diagnostics\" />
    <Folder Include="Serialization/JSON/" />
    <Folder Include="Serialization\Text\" />
    <Folder Include="Serialization\Parquet\" />
    <Folder Include="Serialization\DataReader\" />
  </ItemGroup>
</Project>